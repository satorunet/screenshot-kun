{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "__MSG_short__",
  "version": "1.4",
  "description": "__MSG_desc__",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen",
    "tabCapture",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_short__",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_cmd__"
    }
  },
  "default_locale": "en"
}